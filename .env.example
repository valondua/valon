# Server-only configuration. Never commit .env or put these values in WordPress page content.
# For production, use your hosting secret manager and a private file path outside the web root.
VP_EDITORIAL_DIR=
VP_TIKTOK_ACCOUNT_ID=
VP_TIKTOK_ACCESS_TOKEN=
VP_TIKTOK_REFRESH_TOKEN=
VP_TIKTOK_CLIENT_ID=
VP_TIKTOK_CLIENT_SECRET=
# Unix timestamp returned with the authorized token; required for proactive refresh.
VP_TIKTOK_EXPIRES_AT=
VP_INSTAGRAM_ACCOUNT_ID=
VP_INSTAGRAM_ACCESS_TOKEN=
# Use an Instagram long-lived token eligible for refresh (at least 24 hours old).
VP_INSTAGRAM_EXPIRES_AT=
VP_FACEBOOK_ACCOUNT_ID=
VP_FACEBOOK_ACCESS_TOKEN=
VP_FACEBOOK_EXPIRES_AT=
VP_MAILCHIMP_API_KEY=
VP_MAILCHIMP_LIST_ID=
